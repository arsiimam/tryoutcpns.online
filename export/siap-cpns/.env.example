# =============================================================================
# SiapCPNS — Environment Variables
# Salin file ini menjadi .env dan isi nilainya sebelum menjalankan aplikasi
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://siapcpns:rahasia_ganti_ini@db:5432/siapcpns

# Password untuk database PostgreSQL (digunakan docker-compose)
DB_PASSWORD=rahasia_ganti_ini

# ---------------------------------------------------------------------------
# SESSION
# Gunakan string acak panjang minimal 32 karakter
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# ---------------------------------------------------------------------------
SESSION_SECRET=session_secret_ganti_ini_min_32_karakter_acak

# ---------------------------------------------------------------------------
# URL Aplikasi (WAJIB)
# URL publik tempat aplikasi diakses. Tanpa trailing slash.
# Contoh production: https://siapcpns.id
# Contoh development: http://localhost
# ---------------------------------------------------------------------------
APP_URL=http://localhost

# ---------------------------------------------------------------------------
# Port HTTP (untuk docker-compose)
# ---------------------------------------------------------------------------
HTTP_PORT=80

# ---------------------------------------------------------------------------
# Google OAuth (opsional — untuk fitur Login dengan Google)
# Buat di: https://console.cloud.google.com/
# Authorized redirect URI: {APP_URL}/api/auth/google/callback
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Duitku Payment Gateway (opsional — untuk fitur pembayaran)
# Daftar di: https://duitku.com/
# ---------------------------------------------------------------------------
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Environment: sandbox | production
DUITKU_ENVIRONMENT=sandbox
