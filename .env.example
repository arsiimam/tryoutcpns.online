# =============================================================================
# SiapCPNS — Environment Variables
# Copy file ini: cp .env.example .env
# Lalu isi nilai yang sesuai
# =============================================================================

# ---------------------------------------------------------------------------
# DATABASE (WAJIB)
# ---------------------------------------------------------------------------
# Format: postgres://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgres://siapcpns:GANTI_PASSWORD_DB@localhost:5432/siapcpns

# ---------------------------------------------------------------------------
# SESSION (WAJIB)
# ---------------------------------------------------------------------------
# String acak minimal 32 karakter. Generate: openssl rand -base64 32
SESSION_SECRET=GANTI_INI_DENGAN_STRING_ACAK_MINIMAL_32_KARAKTER

# ---------------------------------------------------------------------------
# URL APLIKASI (WAJIB untuk production)
# ---------------------------------------------------------------------------
# URL publik server tanpa trailing slash
APP_URL=https://domain-anda.com

# Port internal API server — pakai 3009 di VPS (3001 biasanya dipakai app lain)
API_PORT=3009

# ---------------------------------------------------------------------------
# PENYIMPANAN GAMBAR DI VPS
# ---------------------------------------------------------------------------
# Gunakan mode ini saat aplikasi berjalan di VPS, bukan App Storage Replit.
# Folder harus writable oleh user yang menjalankan PM2.
OBJECT_STORAGE_MODE=local
LOCAL_STORAGE_DIR=/var/www/tryoutcpns/storage

# ---------------------------------------------------------------------------
# GOOGLE OAUTH (opsional — untuk login dengan Google)
# ---------------------------------------------------------------------------
# Buat di: https://console.cloud.google.com/
# Authorized redirect URI: https://domain-anda.com/api/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# DUITKU PAYMENT GATEWAY (opsional — untuk pembayaran)
# ---------------------------------------------------------------------------
# Daftar di: https://www.duitku.com/
DUITKU_MERCHANT_CODE=
DUITKU_API_KEY=
# Nilai: sandbox | production
DUITKU_ENVIRONMENT=sandbox

# ---------------------------------------------------------------------------
# EMAIL / SMTP (untuk reset password)
# ---------------------------------------------------------------------------
# Gunakan Gmail, Hostinger, atau SMTP server apapun
# Gmail: aktifkan "App Password" di akun Google → gunakan sebagai SMTP_PASS
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Nama pengirim (opsional, default: SMTP_USER)
SMTP_FROM="Tryout CPNS Online <noreply@tryoutcpns.online>"

# ---------------------------------------------------------------------------
# NODE
# ---------------------------------------------------------------------------
NODE_ENV=production
